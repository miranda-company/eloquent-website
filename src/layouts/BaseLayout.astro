---
import ConsentBanner from '../components/ConsentBanner.astro';
import ImageLightbox from '../components/ImageLightbox.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
}

const {
  title,
  description,
  image = '/brand/opengraph-eloquent.jpg',
  type = 'website',
  publishedTime,
  modifiedTime,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, 'https://eloquent.es').toString();
const imageUrl = new URL(image, 'https://eloquent.es').toString();
const staging = import.meta.env.PUBLIC_STAGING === 'true';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/brand/favicon.jpg" type="image/jpeg" />
    <link rel="canonical" href={canonical} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={staging ? 'noindex, nofollow' : 'index, follow'} />
    <meta property="og:type" content={type} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content="Eloquent" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <script is:inline>
      (() => {
        const consentKey = 'eloquent:consent-preferences';
        const legacyConsentKey = 'eloquent:analytics-consent';
        const containerId = 'GTM-MPRT28KC';
        const dataLayer = (window.dataLayer = window.dataLayer || []);
        const gtag = (...args) => dataLayer.push(args);
        let gtmLoaded = false;

        gtag('consent', 'default', {
          ad_storage: 'denied',
          ad_user_data: 'denied',
          ad_personalization: 'denied',
          analytics_storage: 'denied',
        });

        const loadGtm = () => {
          if (gtmLoaded) return;

          gtmLoaded = true;
          dataLayer.push({ 'gtm.start': Date.now(), event: 'gtm.js' });

          const script = document.createElement('script');
          script.async = true;
          script.src = 'https://www.googletagmanager.com/gtm.js?id=' + containerId;
          document.head.append(script);
        };

        const readPreferences = () => {
          try {
            const stored = window.localStorage.getItem(consentKey);
            if (stored) {
              const parsed = JSON.parse(stored);
              if (parsed.version === 2) {
                return {
                  analytics: parsed.analytics === true,
                  marketing: parsed.marketing === true,
                };
              }
            }

            const legacyChoice = window.localStorage.getItem(legacyConsentKey);
            if (legacyChoice === 'granted' || legacyChoice === 'denied') {
              return { analytics: legacyChoice === 'granted', marketing: false };
            }
          } catch {
            // Storage can be unavailable in restricted browser contexts.
          }

          return { analytics: false, marketing: false };
        };

        const applyConsent = (preferences) => {
          const analytics = preferences.analytics === true;
          const marketing = preferences.marketing === true;
          gtag('consent', 'update', {
            ad_storage: marketing ? 'granted' : 'denied',
            ad_user_data: marketing ? 'granted' : 'denied',
            ad_personalization: marketing ? 'granted' : 'denied',
            analytics_storage: analytics ? 'granted' : 'denied',
          });

          if (analytics || marketing) loadGtm();
        };

        applyConsent(readPreferences());
        document.addEventListener('eloquent:consent-change', (event) => {
          applyConsent(event.detail);
        });
      })();
    </script>
  </head>
  <body id="top">
    <ConsentBanner />
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <SiteHeader />
    <main id="contenido"><slot /></main>
    <SiteFooter />
    <ImageLightbox />
    <a class="back-to-top" href="#top" aria-label="Volver arriba">
      <span aria-hidden="true">↑</span>
    </a>
    <script>
      import {
        initiallyVisibleViewportFraction,
        revealObserver,
        scrollThresholds,
      } from '../design/interaction';

      const initializeScrollControls = () => {
        const header = document.querySelector<HTMLElement>('.site-header');
        const backToTop = document.querySelector<HTMLElement>('.back-to-top');
        if (!header || !backToTop) return;

        let headerHeight = header.offsetHeight;
        const sync = () => {
          if (window.scrollY >= scrollThresholds.stickyHeaderPx) {
            header.classList.add('is-sticky');
          } else if (window.scrollY <= headerHeight) {
            // Release the sticky header when its original position is visible again.
            header.classList.remove('is-sticky');
          }

          backToTop.classList.toggle('is-visible', window.scrollY >= scrollThresholds.backToTopPx);
        };

        window.addEventListener('scroll', sync, { passive: true });
        window.addEventListener('resize', () => {
          headerHeight = header.offsetHeight;
          sync();
        });
        sync();
      };

      const initializeReveals = () => {
        if (
          window.matchMedia('(prefers-reduced-motion: reduce)').matches ||
          !('IntersectionObserver' in window)
        ) {
          return;
        }

        const targets = document.querySelectorAll<HTMLElement>('[data-reveal]');
        const observer = new IntersectionObserver((entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;

            const target = entry.target as HTMLElement;
            target.classList.remove('reveal-pending');
            target.classList.add('reveal-visible');
            observer.unobserve(target);
          }
        }, revealObserver);

        for (const target of targets) {
          const startsInViewport =
            target.getBoundingClientRect().top <
            window.innerHeight * initiallyVisibleViewportFraction;
          if (startsInViewport) continue;

          target.classList.add('reveal-pending');
          observer.observe(target);
        }
      };

      initializeScrollControls();
      initializeReveals();
    </script>
  </body>
</html>
