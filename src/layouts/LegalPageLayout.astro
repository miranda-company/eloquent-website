---
import PageHero from '../components/PageHero.astro';
import BaseLayout from './BaseLayout.astro';
import '../styles/legal-page.css';

interface NavigationItem {
  id: string;
  label: string;
}

interface SummaryItem {
  label: string;
  value: string;
}

interface Props {
  title: string;
  metaTitle: string;
  description: string;
  intro: string;
  updated?: string;
  navigation: readonly NavigationItem[];
  summary?: readonly SummaryItem[];
  notice?: {
    title: string;
    text: string;
  };
}

const {
  title,
  metaTitle,
  description,
  intro,
  updated,
  navigation,
  summary = [],
  notice,
} = Astro.props;
---

<BaseLayout title={metaTitle} description={description}>
  <PageHero titleId="legal-page-title" eyebrow="Información legal" lead={intro}>
    <Fragment slot="title">{title}</Fragment>
    {updated && <Fragment slot="footnote">Última actualización: {updated}</Fragment>}
  </PageHero>

  {
    (notice || summary.length > 0) && (
      <section class="legal-overview" aria-label="Resumen de la página legal">
        <div class="container">
          {notice && (
            <aside class="legal-notice" aria-labelledby="legal-notice-title" data-reveal>
              <h2 id="legal-notice-title">{notice.title}</h2>
              <p>{notice.text}</p>
            </aside>
          )}

          {summary.length > 0 && (
            <dl class="legal-summary" data-reveal>
              {summary.map((item) => (
                <div>
                  <dt class="eyebrow">{item.label}</dt>
                  <dd>{item.value}</dd>
                </div>
              ))}
            </dl>
          )}
        </div>
      </section>
    )
  }

  <section class="legal-content" aria-label={`Contenido de ${title}`}>
    <div class="container legal-content__grid">
      <aside class="legal-toc" data-reveal>
        <nav aria-label="En esta página">
          <p class="eyebrow">En esta página</p>
          <ol>
            {
              navigation.map((item) => (
                <li>
                  <a href={`#${item.id}`}>{item.label}</a>
                </li>
              ))
            }
          </ol>
        </nav>
      </aside>

      <article class="legal-article">
        <slot />
      </article>
    </div>
  </section>
</BaseLayout>
