---
import EloquentLogo from './EloquentLogo.astro';
import { services } from '../data/services';

const isHome = Astro.url.pathname === '/';
const isPersonalPage = Astro.url.pathname === '/servicios/landing-page-personal/';
const isWorkPage = Astro.url.pathname.startsWith('/trabajo/');
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="brand" href="/" aria-label="Eloquent, inicio">
      <EloquentLogo />
    </a>
    <nav class="site-nav" aria-label="Navegación principal">
      <a href="/" aria-current={isHome ? 'page' : undefined}>Inicio</a>
      <details class="site-nav__services">
        <summary>Servicios</summary>
        <ul>
          {
            services.map((service) => (
              <li>
                <a href={`/#${service.id}`}>{service.shortName}</a>
              </li>
            ))
          }
          <li>
            <a
              href="/servicios/landing-page-personal/"
              aria-current={isPersonalPage ? 'page' : undefined}
            >
              Landing Page Personal
            </a>
          </li>
        </ul>
      </details>
      <a href="/trabajo/" aria-current={isWorkPage ? 'page' : undefined}>Trabajo</a>
      <a href="https://eloquent.es/dossier/">Dossier</a>
    </nav>
    <a class="header-contact" href="mailto:info@eloquent.es"
      >Hablemos <span aria-hidden="true">↗</span></a
    >
  </div>
</header>

<script>
  const servicesMenu = document.querySelector<HTMLDetailsElement>('.site-nav__services');

  if (servicesMenu) {
    document.addEventListener('click', (event) => {
      if (servicesMenu.open && !event.composedPath().includes(servicesMenu)) {
        servicesMenu.open = false;
      }
    });

    servicesMenu.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && servicesMenu.open) {
        servicesMenu.open = false;
        servicesMenu.querySelector('summary')?.focus();
      }
    });

    servicesMenu.addEventListener('click', (event) => {
      const target = event.target;
      if (target instanceof Element && target.closest('a')) {
        servicesMenu.open = false;
      }
    });
  }
</script>
