---
import type { ImageMetadata } from 'astro';
import AssetImage from './AssetImage.astro';

interface MetaItem {
  label: string;
  value: string;
}

interface Props {
  titleId: string;
  eyebrow: string;
  lead: string;
  image: ImageMetadata;
  imageAlt: string;
  meta: readonly MetaItem[];
  projectHref?: string;
}

const { titleId, eyebrow, lead, image, imageAlt, meta, projectHref = '#proyecto' } = Astro.props;
---

<section class="case-study-hero" aria-labelledby={titleId}>
  <div class="case-study-hero__visual">
    <AssetImage
      class="case-study-hero__image"
      src={image}
      alt={imageAlt}
      loading="eager"
      fetchpriority="high"
    />
    <div class="case-study-hero__scrim">
      <div class="container case-study-hero__content">
        <p class="eyebrow eyebrow--light">{eyebrow}</p>
        <h1 class="case-study-hero__title" id={titleId}><slot name="title" /></h1>
        <p class="case-study-hero__lead">{lead}</p>
      </div>
    </div>
  </div>
  <div class="case-study-hero__meta">
    <div class="container case-study-hero__meta-grid">
      <a class="text-link" href={projectHref}>
        Ver el proyecto <span aria-hidden="true">↓</span>
      </a>
      <dl>
        {
          meta.map((item) => (
            <div>
              <dt>{item.label}</dt>
              <dd>{item.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>
