---
interface Props {
  titleId: string;
  eyebrow: string;
  title: string;
  description: string;
}

const { titleId, eyebrow, title, description } = Astro.props;
---

<header class="collection-heading" data-reveal>
  <div>
    <p class="eyebrow">{eyebrow}</p>
    <h2 id={titleId}>{title}</h2>
  </div>
  <p>{description}</p>
</header>
