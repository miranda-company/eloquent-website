---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface IssueLink {
  title: string;
  href: string;
}

interface Author {
  name: string;
  url?: string;
}

interface Props {
  titleId: string;
  title: string;
  summary: string;
  author: Author;
  date: Date;
  updated: Date;
  image?: ImageMetadata;
  issues: readonly IssueLink[];
}

const { titleId, title, summary, author, date, updated, image, issues } = Astro.props;
const publicationDate = date.toISOString().slice(0, 10);
const dateFormatter = new Intl.DateTimeFormat('es-ES', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
const publicationLabel = dateFormatter.format(date);
const updateDate = updated.toISOString().slice(0, 10);
const updateLabel = dateFormatter.format(updated);
const imageWidths = [640, 960, 1360, 1920];
---

<header class="dossier-article-hero">
  <div class="container">
    <div class="dossier-article-hero__grid">
      <div class="dossier-article-hero__intro">
        <p class="eyebrow eyebrow--light">Dossier · Artículo</p>
        <h1 id={titleId}>{title}</h1>
        <p class="dossier-article-hero__summary">{summary}</p>
      </div>

      <dl class="dossier-article-hero__meta">
        <div>
          <dt>Autor</dt>
          <dd>
            {
              author.url ? (
                <a
                  href={author.url}
                  target="_blank"
                  rel="author external noopener noreferrer"
                  aria-label={`${author.name} (abre en una pestaña nueva)`}
                >
                  {author.name}
                </a>
              ) : (
                author.name
              )
            }
          </dd>
        </div>
        <div>
          <dt>Publicado</dt>
          <dd><time datetime={publicationDate}>{publicationLabel}</time></dd>
        </div>
        <div>
          <dt>Actualizado</dt>
          <dd><time datetime={updateDate}>{updateLabel}</time></dd>
        </div>
        {
          issues.length > 0 && (
            <div>
              <dt>Aparece en</dt>
              <dd>
                <ul>
                  {issues.map((issue) => (
                    <li>
                      <a href={issue.href}>{issue.title}</a>
                    </li>
                  ))}
                </ul>
              </dd>
            </div>
          )
        }
      </dl>
    </div>
  </div>

  {
    image && (
      <figure class="dossier-article-hero__media">
        <Image
          src={image}
          alt=""
          widths={imageWidths}
          sizes="100vw"
          format="webp"
          quality={78}
          loading="eager"
          fetchpriority="high"
        />
      </figure>
    )
  }
</header>
