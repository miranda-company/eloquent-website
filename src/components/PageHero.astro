---
interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  titleId: string;
  eyebrow: string;
  lead?: string;
  intro?: string;
  breadcrumbs?: readonly BreadcrumbItem[];
}

const { titleId, eyebrow, lead, intro, breadcrumbs = [] } = Astro.props;
const hasCopy = Boolean(lead || intro);
const hasActions = Astro.slots.has('actions');
const hasFootnote = Astro.slots.has('footnote');
---

<section class="page-hero" aria-labelledby={titleId}>
  <div class="container page-hero__inner">
    {
      breadcrumbs.length > 0 && (
        <nav class="page-hero__breadcrumb" aria-label="Ruta de navegación">
          <ol>
            {breadcrumbs.map((item, index) => (
              <li aria-current={index === breadcrumbs.length - 1 ? 'page' : undefined}>
                {item.href ? <a href={item.href}>{item.label}</a> : item.label}
              </li>
            ))}
          </ol>
        </nav>
      )
    }
    <div class="page-hero__body">
      <p class="eyebrow eyebrow--light">{eyebrow}</p>
      <h1 class="page-hero__title" id={titleId}><slot name="title" /></h1>
      {
        hasCopy && (
          <div class="page-hero__copy">
            {lead && <p class="page-hero__lead">{lead}</p>}
            {intro && <p class="page-hero__intro">{intro}</p>}
          </div>
        )
      }
      {
        hasActions && (
          <div class="page-hero__actions">
            <slot name="actions" />
          </div>
        )
      }
      {
        hasFootnote && (
          <p class="page-hero__footnote">
            <slot name="footnote" />
          </p>
        )
      }
    </div>
  </div>
</section>
