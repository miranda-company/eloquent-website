---
interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  titleId: string;
  eyebrow?: string;
  eyebrowHighlight?: string;
  lead?: string;
  intro?: string;
  breadcrumbs?: readonly BreadcrumbItem[];
  balancedSpacing?: boolean;
}

const {
  titleId,
  eyebrow,
  eyebrowHighlight,
  lead,
  intro,
  breadcrumbs = [],
  balancedSpacing = false,
} = Astro.props;
const hasEyebrow = Boolean(eyebrow || eyebrowHighlight);
const hasCopy = Boolean(lead || intro);
const hasActions = Astro.slots.has('actions');
const hasFootnote = Astro.slots.has('footnote');
const hasFooter = Astro.slots.has('footer');
const hasBackground = Astro.slots.has('background');
---

<section
  class:list={['page-hero', { 'page-hero--balanced': balancedSpacing }]}
  aria-labelledby={titleId}
>
  {hasBackground && <slot name="background" />}
  <div class="container page-hero__inner">
    {
      breadcrumbs.length > 0 && (
        <nav class="page-hero__breadcrumb" aria-label="Ruta de navegación">
          <ol>
            {breadcrumbs.map((item, index) => (
              <li aria-current={index === breadcrumbs.length - 1 ? 'page' : undefined}>
                {item.href ? <a href={item.href}>{item.label}</a> : item.label}
              </li>
            ))}
          </ol>
        </nav>
      )
    }
    <div class="page-hero__body">
      {
        hasEyebrow && (
          <p class="eyebrow eyebrow--light">
            {eyebrowHighlight && (
              <span class="page-hero__eyebrow-highlight">{eyebrowHighlight}</span>
            )}
            {eyebrowHighlight && eyebrow && <span aria-hidden="true"> · </span>}
            {eyebrow}
          </p>
        )
      }
      <h1 class="page-hero__title" id={titleId}><slot name="title" /></h1>
      {
        hasCopy && (
          <div class="page-hero__copy">
            {lead && <p class="page-hero__lead">{lead}</p>}
            {intro && <p class="page-hero__intro">{intro}</p>}
          </div>
        )
      }
      {
        hasActions && (
          <div class="page-hero__actions">
            <slot name="actions" />
          </div>
        )
      }
      {
        hasFootnote && (
          <p class="page-hero__footnote">
            <slot name="footnote" />
          </p>
        )
      }
    </div>
    {
      hasFooter && (
        <div class="page-hero__footer">
          <slot name="footer" />
        </div>
      )
    }
  </div>
</section>
