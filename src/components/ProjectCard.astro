---
import type { Project } from '../data/projects';
import AssetImage from './AssetImage.astro';

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<li class="project-card" data-reveal>
  <article>
    <a href={project.href} aria-label={`Ver el caso de ${project.title}`}>
      <figure>
        <div class="project-card__media">
          <AssetImage src={project.image} alt={project.imageAlt} />
        </div>
        <figcaption>
          <p class="project-card__sector">{project.sector}</p>
          <h3>{project.title}</h3>
          <p class="project-card__summary">{project.summary}</p>
          <span class="project-card__link">
            Ver proyecto <span aria-hidden="true">↗</span>
          </span>
        </figcaption>
      </figure>
    </a>
  </article>
</li>
