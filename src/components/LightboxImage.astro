---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  widths: number[];
  sizes: string;
  quality?: number;
  eager?: boolean;
}

const { src, alt, caption = alt, widths, sizes, quality = 65, eager = false } = Astro.props;
---

<a
  class="lightbox-trigger"
  href={src.src}
  target="_blank"
  rel="noopener"
  aria-label={`Ampliar imagen: ${alt}`}
  aria-haspopup="dialog"
  data-lightbox-trigger
  data-lightbox-caption={caption}
>
  <Image
    src={src}
    alt={alt}
    widths={widths}
    sizes={sizes}
    format="webp"
    quality={quality}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : undefined}
  />
</a>
