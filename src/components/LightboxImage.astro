---
import type { ImageMetadata } from 'astro';
import AssetImage from './AssetImage.astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
}

const { src, alt, caption = alt } = Astro.props;
---

<a
  class="lightbox-trigger"
  href={src.src}
  target="_blank"
  rel="noopener"
  aria-label={`Ampliar imagen: ${alt}`}
  aria-haspopup="dialog"
  data-lightbox-trigger
  data-lightbox-caption={caption}
>
  <AssetImage src={src} alt={alt} />
</a>
