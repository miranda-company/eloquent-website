---
import type { ImageMetadata } from 'astro';
import LightboxImage from './LightboxImage.astro';

interface GalleryImage {
  src: ImageMetadata;
  alt: string;
}

interface Props {
  images: readonly GalleryImage[];
  label: string;
  layout?: 'single' | 'duo' | 'triptych';
  surface?: 'paper' | 'surface' | 'sage' | 'accent' | 'dark';
}

const { images, label, layout = 'single', surface = 'paper' } = Astro.props;
---

<div
  class:list={['media-gallery', `media-gallery--${layout}`, `media-gallery--${surface}`]}
  role="group"
  aria-label={label}
>
  <div class="container">
    <ul class="media-gallery__list">
      {
        images.map((image) => (
          <li data-reveal>
            <figure>
              <LightboxImage src={image.src} alt={image.alt} />
            </figure>
          </li>
        ))
      }
    </ul>
  </div>
</div>
