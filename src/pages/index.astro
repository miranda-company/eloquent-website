---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import bscImage from '../assets/barcelona-supercomputing-center.jpg';
import museumImage from '../assets/museu-lhospitalet.jpg';
import swimImage from '../assets/cn-sant-andreu.jpg';
import { services } from '../data/services';
import '../styles/home.css';

const featuredImageWidths = [480, 920, 1360];
const cardImageWidths = [480, 720];
const featuredImageSizes = '100vw';
const cardImageSizes = '(max-width: 600px) 100vw, 50vw';

const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Eloquent',
  url: 'https://eloquent.es/',
  description: 'Consultoría de comunicación y experiencia digital.',
  email: 'info@eloquent.es',
};
---

<BaseLayout
  title="Eloquent — Comunicación clara para organizaciones complejas"
  description="Ayudamos a organizaciones a explicarse mejor. Convertimos conocimiento complejo en comunicación clara, creíble y útil."
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(organization)} />

  <section class="hero" aria-labelledby="hero-title">
    <div class="container">
      <p class="eyebrow eyebrow--light">Consultoría de comunicación y experiencia digital</p>
      <h1 id="hero-title">Ayudamos a organizaciones a <em>explicarse mejor.</em></h1>
      <p class="hero__lead">
        Clarificamos lo que saben, lo que hacen y por qué importa, transformándolo en comunicación
        clara, creíble y útil.
      </p>
      <div class="hero__actions">
        <a class="button button--light" href="mailto:info@eloquent.es">
          Cuéntanos tu reto <span aria-hidden="true">↗</span>
        </a>
        <a class="text-link text-link--light" href="https://dcc.eloquent.es/">
          Explora el DCC <span aria-hidden="true">↗</span>
        </a>
      </div>
      <p class="hero__footnote">Ideas claras. Sistemas conectados. Confianza que se construye.</p>
    </div>
  </section>

  <section class="proposition" aria-labelledby="proposition-title">
    <div class="container proposition__grid">
      <p class="eyebrow" data-reveal>El reto / 01</p>
      <h2 id="proposition-title" data-reveal>
        Comunicar se está volviendo <em>más difícil.</em>
      </h2>
      <p class="proposition__lead" data-reveal>
        En un mundo enmarcado por la desinformación, la inteligencia artificial y la desconfianza,
        la comunicación estratégica ayuda a las organizaciones a generar comprensión, legitimidad y
        confianza.
      </p>
      <p class="proposition__note" data-reveal>
        Cuando el conocimiento no está bien explicado, estructurado o traducido para sus públicos,
        se pierde. Nosotros ayudamos a convertirlo en claridad.
      </p>
    </div>
  </section>

  <section class="services" aria-labelledby="services-title">
    <div class="container">
      <p class="eyebrow" data-reveal>Qué hacemos / 02</p>
      <div class="section-heading" data-reveal>
        <h2 id="services-title">
          Sistemas de comunicación para generar <em>claridad y confianza.</em>
        </h2>
        <p>
          Ayudamos a organizaciones complejas a convertir conocimiento en confianza mediante
          diagnósticos, metodologías y sistemas de comunicación.
        </p>
      </div>
      <ul class="service-list">
        {
          services.map((service) => (
            <li id={service.id} data-reveal>
              <span class="service-list__label">{service.shortName}</span>
              <h3>{service.title}</h3>
              <p>{service.description}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="work" aria-labelledby="work-title">
    <div class="container">
      <p class="eyebrow" data-reveal>En la práctica / 03</p>
      <div class="section-heading section-heading--work" data-reveal>
        <h2 id="work-title">Trabajo <em>seleccionado.</em></h2>
        <a class="text-link" href="https://eloquent.es/trabajo/">
          Ver todo el trabajo <span aria-hidden="true">↗</span>
        </a>
      </div>
      <ul class="work-list">
        <li data-reveal>
          <a href="https://eloquent.es/trabajo/cn-sant-andreu/">
            <figure>
              <Image
                src={swimImage}
                alt="Nadador del Club Natació Sant Andreu en la piscina"
                widths={featuredImageWidths}
                sizes={featuredImageSizes}
                format="webp"
                quality={65}
                loading="lazy"
              />
              <figcaption>
                <span>Deporte · Estrategia de comunicación</span>
                <h3>Club Natació Sant Andreu <span aria-hidden="true">↗</span></h3>
                <p>Auditoría y estrategia de comunicación para un club de natación en Barcelona.</p>
              </figcaption>
            </figure>
          </a>
        </li>
        <li data-reveal>
          <a href="https://eloquent.es/trabajo/museu-de-lhospitalet/">
            <figure>
              <Image
                src={museumImage}
                alt="Detalle de una escultura en el Museu de L’Hospitalet"
                widths={cardImageWidths}
                sizes={cardImageSizes}
                format="webp"
                quality={65}
                loading="lazy"
              />
              <figcaption>
                <span>Cultura · Estrategia y equipo</span>
                <h3>Museu de L’Hospitalet <span aria-hidden="true">↗</span></h3>
                <p>Una estrategia de comunicación compartida para alinear al equipo.</p>
              </figcaption>
            </figure>
          </a>
        </li>
        <li data-reveal>
          <a href="https://eloquent.es/trabajo/barcelona-supercomputing-center/">
            <figure>
              <Image
                src={bscImage}
                alt="Instalación de computación del Barcelona Supercomputing Center"
                widths={cardImageWidths}
                sizes={cardImageSizes}
                format="webp"
                quality={65}
                loading="lazy"
              />
              <figcaption>
                <span>Ciencia · Accesibilidad de la información</span>
                <h3>Barcelona Supercomputing Center <span aria-hidden="true">↗</span></h3>
                <p>Información meteorológica más accesible para públicos no especializados.</p>
              </figcaption>
            </figure>
          </a>
        </li>
      </ul>
    </div>
  </section>

  <section class="dossier-feature" aria-labelledby="dossier-title">
    <div class="container dossier-feature__grid">
      <p class="eyebrow" data-reveal>Dossier / 04</p>
      <h2 id="dossier-title" data-reveal>
        Ideas para pensar la comunicación <em>con más claridad.</em>
      </h2>
      <div class="dossier-feature__issue" data-reveal>
        <p>Última exploración</p>
        <h3>Fundamentos de la comunicación estratégica</h3>
        <p>
          La comunicación empieza con la comprensión de quiénes somos, a quiénes servimos, qué
          problemas resolvemos y qué queremos que la gente entienda.
        </p>
        <a
          class="button button--dark"
          href="https://eloquent.es/dossier/fundamentos-de-la-comunicacion/"
        >
          Abrir dossier <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </section>

  <section class="about" aria-labelledby="about-title">
    <div class="container about__grid">
      <p class="eyebrow" data-reveal>Quiénes somos / 05</p>
      <h2 id="about-title" data-reveal>
        Conocimiento complejo, <em>claridad compartida.</em>
      </h2>
      <p data-reveal>
        Desde 2018 ayudamos a organizaciones en España y LATAM a mejorar su comunicación. Combinamos
        comunicación institucional, estrategia digital y experiencia de usuario para crear sistemas
        útiles que los equipos puedan sostener.
      </p>
      <a class="text-link" href="mailto:info@eloquent.es" data-reveal>
        Conoce cómo podemos ayudarte <span aria-hidden="true">↗</span>
      </a>
    </div>
  </section>
</BaseLayout>
