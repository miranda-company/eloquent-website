---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import HeroVectorField from '../components/HeroVectorField.astro';
import ClientLogoCarousel from '../components/ClientLogoCarousel.astro';
import AssetImage from '../components/AssetImage.astro';
import { projects } from '../data/projects';
import { services } from '../data/services';
import '../styles/home.css';

const [swimProject, museumProject, bscProject] = projects;

const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Eloquent',
  url: 'https://eloquent.es/',
  description: 'Consultoría de comunicación y experiencia digital.',
  email: 'info@eloquent.es',
};
---

<BaseLayout
  title="Eloquent — Consultoría de comunicación y experiencia digital."
  description="Ayudamos a organizaciones a explicarse mejor. Convertimos conocimiento y experiencia en comunicación clara, creíble y útil."
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(organization)} />

  <PageHero
    titleId="hero-title"
    lead="Ayudamos a organizaciones en España a construir una voz más clara, humana y memorable."
  >
    <Fragment slot="background"><HeroVectorField /></Fragment>
    <Fragment slot="title">Sé memorable. <em>Ábrete camino entre el ruido.</em></Fragment>
    <Fragment slot="actions">
      <a class="button button--light" href="mailto:info@eloquent.es">
        Cuéntanos tu proyecto <span aria-hidden="true">↗</span>
      </a>
      <a class="text-link text-link--light" href="https://dcc.eloquent.es/">
        Explora el DCC <span aria-hidden="true">↗</span>
      </a>
    </Fragment>
    <Fragment slot="footer"><ClientLogoCarousel /></Fragment>
  </PageHero>

  <section class="proposition" aria-labelledby="proposition-title">
    <div class="container proposition__grid">
      <h2 id="proposition-title" data-reveal>
        ¿Estás bloqueado porque tu comunicación pasa desapercibida y no conecta?
      </h2>
      <p class="proposition__lead" data-reveal>
        Atravesamos una época enmarcada por la desconfianza y por cambios tecnológicos que generan
        un entorno saturado. En este escenario, la comunicación estratégica es la herramienta que
        puede marcar la diferencia.
      </p>
      <div class="proposition__media" data-reveal>
        <span class="proposition__play-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M8 5.5v13l10-6.5z"></path>
          </svg>
        </span>
        <p class="proposition__media-label">
          <strong>Los retos de comunicar en un mundo dominado por la IA y la desconfianza.</strong>
          <span>La comunicación importa ep.001 | Eloquent</span>
          <span class="proposition__media-status">Próximamente</span>
        </p>
      </div>
    </div>
  </section>

  <section class="services" aria-labelledby="services-title">
    <div class="container">
      <p class="eyebrow" data-reveal>Nuestros sistemas</p>
      <div class="section-heading" data-reveal>
        <h2 id="services-title">
          Comunicación para generar <em>claridad y confianza.</em>
        </h2>
        <p>
          Comunicar bien es tener las ideas claras, una voz humana y una forma de expresarla que
          merezca ser recordada.
        </p>
      </div>
      <ul class="service-list">
        {
          services.map((service) => (
            <li id={service.id} data-reveal>
              <span class="service-list__label">{service.shortName}</span>
              <h3>{service.title}</h3>
              <p>{service.description}</p>
              {service.pageHref && (
                <a class="text-link" href={service.pageHref}>
                  Conoce {service.shortName} <span aria-hidden="true">↗</span>
                </a>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="work" aria-labelledby="work-title">
    <div class="container">
      <div class="section-heading section-heading--work" data-reveal>
        <h2 id="work-title">Trabajo <em>seleccionado.</em></h2>
        <a class="text-link" href="/trabajo/">
          Ver todo el trabajo <span aria-hidden="true">↗</span>
        </a>
      </div>
      <ul class="work-list">
        <li data-reveal>
          <a href={swimProject.href}>
            <figure>
              <AssetImage src={swimProject.image} alt={swimProject.imageAlt} />
              <figcaption>
                <span>{swimProject.sector}</span>
                <h3>{swimProject.title} <span aria-hidden="true">↗</span></h3>
                <p>{swimProject.homeSummary}</p>
              </figcaption>
            </figure>
          </a>
        </li>
        <li data-reveal>
          <a href={museumProject.href}>
            <figure>
              <AssetImage src={museumProject.image} alt={museumProject.imageAlt} />
              <figcaption>
                <span>{museumProject.sector}</span>
                <h3>{museumProject.title} <span aria-hidden="true">↗</span></h3>
                <p>{museumProject.homeSummary}</p>
              </figcaption>
            </figure>
          </a>
        </li>
        <li data-reveal>
          <a href={bscProject.href}>
            <figure>
              <AssetImage src={bscProject.image} alt={bscProject.imageAlt} />
              <figcaption>
                <span>{bscProject.sector}</span>
                <h3>{bscProject.title} <span aria-hidden="true">↗</span></h3>
                <p>{bscProject.homeSummary}</p>
              </figcaption>
            </figure>
          </a>
        </li>
      </ul>
    </div>
  </section>

  <section class="dossier-feature" aria-labelledby="dossier-title">
    <div class="container dossier-feature__grid">
      <p class="eyebrow" data-reveal>Dossier</p>
      <h2 id="dossier-title" data-reveal>
        Ideas para pensar la comunicación <em>con más claridad.</em>
      </h2>
      <div class="dossier-feature__issue" data-reveal>
        <p>Última exploración</p>
        <h3>Fundamentos de la comunicación estratégica</h3>
        <p>
          La comunicación empieza con la comprensión de quiénes somos, a quiénes servimos, qué
          problemas resolvemos y qué queremos que la gente entienda.
        </p>
        <a class="button button--dark" href="/dossier/fundamentos-de-la-comunicacion/">
          Abrir dossier <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </section>

  <section class="about" aria-labelledby="about-title">
    <div class="container about__grid">
      <p class="eyebrow" data-reveal>Quiénes somos</p>
      <h2 id="about-title" data-reveal>
        Comunicación, <em>creatividad y tecnología.</em>
      </h2>
      <p data-reveal>
        Desde 2018 ayudamos a organizaciones en España a mejorar su comunicación. Combinamos
        comunicación estratégica, experiencia digital, diseño y tecnología para crear sistemas
        útiles y sostenibles que ayuden a las organizaciones a explicarse mejor y a generar
        confianza con sus públicos.
      </p>
      <a class="text-link" href="mailto:info@eloquent.es" data-reveal>
        Conoce cómo podemos ayudarte <span aria-hidden="true">↗</span>
      </a>
    </div>
  </section>
</BaseLayout>
